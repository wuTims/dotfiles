{
  "$schema": "https://claude.ai/settings-schema.json",
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(make:*)"
    ],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Consider running formatter'"
          }
        ]
      }
    ]
  }
}
